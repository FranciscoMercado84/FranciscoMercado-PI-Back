# Servidor
PORT=3001
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/panaderia?retryWrites=true&w=majority
MONGODB_URI_TEST=mongodb+srv://usuario:password@cluster.mongodb.net/panaderia_test?retryWrites=true&w=majority

# JWT
JWT_SECRET=tu_clave_super_secreta_cambiar_en_produccion_minimo_32_caracteres
JWT_EXPIRATION=30d

# Frontend
FRONTEND_URL=http://localhost:5173

# Cloudinary (para gestión de imágenes)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Admin (credenciales iniciales - cambiar en producción)
ADMIN_EMAIL=admin@panaderia.com
ADMIN_PASSWORD=admin123

# Generar secreto JWT:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

