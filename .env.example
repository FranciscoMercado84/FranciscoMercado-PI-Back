# Servidor
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/panaderia
MONGODB_URI_TEST=mongodb://localhost:27017/panaderia_test

# JWT
JWT_SECRET=CAMBIAR_POR_SECRETO_SEGURO_64_CARACTERES
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=CAMBIAR_POR_OTRO_SECRETO_DIFERENTE_64_CARACTERES
JWT_REFRESH_EXPIRATION=30d

# Admin (credenciales iniciales)
ADMIN_EMAIL=admin@panaderia.com
ADMIN_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO

# Generar secretos seguros:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
