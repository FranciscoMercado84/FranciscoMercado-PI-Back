{
  "name": "panaderia-backend",
  "version": "1.0.0",
  "description": "API REST para gestión de panadería con estructura MVC y MongoDB",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:report": "npx sonar-scanner",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "seed": "node scripts/seed.js",
    "upload:images": "node scripts/upload-images-to-cloudinary.js",
    "migrate:categorias": "node scripts/migrate-categorias.js",
    "drop:categorias": "node scripts/drop-categorias-collection.js"
  },
  "author": "Paco",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "vitest": "^4.0.12"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.22.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.18.3",
    "yamljs": "^0.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
